# RevPilot env flags — with NOTHING set, the whole app runs on seed data (mock adapter).
# Copy to app/.env.local (Next.js) or export in the shell for jobs/scripts.

# --- Guesty (execution rail: the only CM public API with OTA promotion management) ---
# GUESTY_ENABLED=true
# GUESTY_CLIENT_ID=...
# GUESTY_CLIENT_SECRET=...
# GUESTY_BASE_URL=https://open-api.guesty.com/v1

# --- Hostaway (second CM: rates/calendar only — no promotion API) ---
# HOSTAWAY_ENABLED=true
# HOSTAWAY_ACCOUNT_ID=...
# HOSTAWAY_API_KEY=...

# --- Booking.com Market Insights (gated connectivity API: demand/pace, NOT the funnel) ---
# BOOKING_INSIGHTS_ENABLED=true
# BOOKING_INSIGHTS_TOKEN=...

# --- ML microservice (falls back to the in-process TS bandit when unreachable) ---
# ML_SERVICE_URL=http://localhost:8787

# --- Nixtla TimeGPT: zero-shot forecast cold-start (used by ml-service) ---
# NIXTLA_API_KEY=...

# --- Optional LLM explainer (the LLM explains; it never computes numbers) ---
# ANTHROPIC_API_KEY=...

# --- Persistence: Postgres/Supabase (production). On serverless use the TRANSACTION-POOLER
# --- url (Supabase: Settings -> Database -> Connection string -> Transaction, port 6543).
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# --- Console auth (default OFF = frictionless demo) ---
# REVPILOT_AUTH=local
# REVPILOT_AUTH_SECRET=generate-a-long-random-string
# REVPILOT_ADMIN_EMAIL=itai@dconsult.me
# REVPILOT_ADMIN_PASSWORD=change-me-before-real-use

# --- Dev store location (JSON persistence of the demo world when DATABASE_URL is unset) ---
# REVPILOT_DATA_FILE=.data/revpilot-state.json
